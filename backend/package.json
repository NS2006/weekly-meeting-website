{
  "name": "@weekly-meeting/backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env --experimental-vm-modules --no-warnings=ExperimentalWarning ../node_modules/jest/bin/jest.js --runInBand",
    "db:format": "prisma format --schema src/database/prisma/schema.prisma",
    "db:validate": "prisma validate --schema src/database/prisma/schema.prisma",
    "db:migrate:new": "prisma migrate dev --create-only --schema src/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema src/database/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema src/database/prisma/schema.prisma",
    "db:status": "prisma migrate status --schema src/database/prisma/schema.prisma",
    "db:seed": "node --env-file-if-exists=.env src/database/seed-dev.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "8.4.0",
    "@weekly-meeting/shared": "*",
    "express": "4.22.3",
    "pg": "8.23.1",
    "pino": "9.14.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  }
}
