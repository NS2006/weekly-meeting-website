# Placeholders only: real values live in backend/.env (gitignored) locally and in Vault on the platform.

# Optional: NODE_ENV (development), HOST (127.0.0.1), PORT (3000), DB_POOL_MAX (10), LOG_LEVEL (info),
# SESSION_TTL_HOURS (8). NODE_ENV=production turns the mock sign-in off and makes cookies Secure.
# A container behind the gateway sets HOST=0.0.0.0.
PORT=3000
LOG_LEVEL=info

# Comma-separated emails that are active website admins on every sign-in (the first admin, and a way back in).
# For local development: admin.test@example.com is the fictitious admin in the login page's test accounts.
ADMIN_EMAILS=

# PostgreSQL 15. Local setup: see src/database/setup-local.sql.
DATABASE_URL="postgresql://weekly_meeting:<password>@localhost:5432/weekly_meeting?schema=public"
# Prisma Migrate's shadow database (development only; not needed for `prisma migrate deploy`).
SHADOW_DATABASE_URL="postgresql://weekly_meeting:<password>@localhost:5432/weekly_meeting_shadow?schema=public"

# Note images. local (default): files in LOCAL_STORAGE_DIR (default uploads/, gitignored), for development.
# gcs: a private Google Cloud Storage bucket, for staging and production (a container's disk is lost on deploy).
# The GCS credentials come from Application Default Credentials (the platform's workload identity), never from here.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=uploads
GCS_BUCKET=
